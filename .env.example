DATABASE_URL=postgresql://user:password@localhost:5432/expenses

# When running the backend directly on the host (e.g. `uvicorn ...` outside
# Docker), SeaweedFS's hostname "seaweedfs" (used in s3.json) isn't
# resolvable. Uncomment this to point at the loopback-only port published by
# docker-compose (127.0.0.1:8333) instead of editing s3.json.
# S3_ENDPOINT_URL=http://localhost:8333