DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/expensesassistant

# When running the backend directly on the host (e.g. `uvicorn ...` outside
# Docker), SeaweedFS's hostname "seaweedfs" (used in s3.json) isn't
# resolvable. Uncomment this to point at the loopback-only port published by
# docker-compose (127.0.0.1:8333) instead of editing s3.json.
# S3_ENDPOINT_URL=http://localhost:8333

# How often the s3-backup service re-archives the "expenses-documents"
# SeaweedFS bucket, in days.
# S3_BACKUP_INTERVAL_DAYS=30

# Used by docker-compose.yml (postgres, pg-backup, pgAdmin). Required.
POSTGRES_PASSWORD=change-me
PGADMIN_DEFAULT_PASSWORD=change-me

# Where the pg-backup / s3-backup services write their dumps, on the host.
# Default: ./backups/postgres and ./backups/s3. Quote paths with spaces.
# POSTGRES_BACKUP_HOST_DIR="C:/path/to/_backups/Postgres"
# S3_BACKUP_HOST_DIR="C:/path/to/_backups/S3"

# Both services also back up once more when their container is stopped
# (docker compose stop/down). Set to false to turn that off.
# POSTGRES_BACKUP_ON_STOP=true
# S3_BACKUP_ON_STOP=true

# The backend (python -m personal_expenses_app.serve) runs both backups when it
# stops. Set to false to turn that off.
# BACKUP_ON_APP_EXIT=true

# A backup identical to the newest one in its folder is skipped. Set to false
# to always write a new one.
# POSTGRES_BACKUP_SKIP_UNCHANGED=true
# S3_BACKUP_SKIP_UNCHANGED=true
